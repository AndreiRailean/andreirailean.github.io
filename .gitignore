# build output
dist/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production
.envrc

# macOS-specific files
.DS_Store

# clide
.clide_state/

# private scratch space — never committed, see docs/agents/issue-tracker.md
.scratch/

# playwright — outputDir is .scratch/playwright, these only appear if a run
# overrides the reporter on the command line
test-results/
playwright-report/

# `pnpm run runners` writes three things and only one of them is generated.
#
# The runners and the manifest are COMMITTED: a published page pins a runner by
# its content hash, so the file has to outlive the build that made it, and the
# manifest is what the Astro build reads to know which one is current. `embed.js`
# is the loader, deliberately mutable, and is rebuilt every time.
public/showcase/embed.js
