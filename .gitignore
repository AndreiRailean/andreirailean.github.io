# build output
dist/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production
.envrc

# macOS-specific files
.DS_Store

# clide
.clide_state/

# private scratch space — never committed, see docs/agents/issue-tracker.md
.scratch/
# throwaway measurements, run with `pnpm run probe` — see vitest.probe.config.mts
probes/

# playwright — outputDir is .scratch/playwright, these only appear if a run
# overrides the reporter on the command line
test-results/
playwright-report/

# `pnpm run runners` builds every piece into `.runners/`, which is disposable:
# delete any of it, and the next build writes it back byte for byte. Runners that
# something names are copied into `public/showcase/runners/`, the store, and
# COMMITTED there: a published page pins a runner by its content hash, so the
# file has to outlive the build that made it. `embed.js` is the loader,
# deliberately mutable, and rebuilt every time.
# `src/experiments/docs/adr/20261106-runner-builds-live-outside-the-store.md`.
.runners/
public/showcase/embed.js
