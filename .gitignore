# build output
dist/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production
.envrc

# macOS-specific files
.DS_Store

# clide
.clide_state/

# private scratch space — never committed, see docs/agents/issue-tracker.md
.scratch/

# playwright — outputDir is .scratch/playwright, these only appear if a run
# overrides the reporter on the command line
test-results/
playwright-report/

# Build output of `pnpm run runners`: frozen runners, the loader, the published
# artefacts and the manifest. Regenerated by `dev` and `build`, never committed —
# a runner's name is its content hash, so committing it would only ever be a
# second copy of something the source already determines.
public/showcase/
