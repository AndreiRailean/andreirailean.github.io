{
  "name": "andrei.md",
  "type": "module",
  "version": "3.0.2",
  "private": true,
  "scripts": {
    "dev": "pnpm run runners && astro dev",
    "start": "pnpm run runners && astro dev",
    "build": "pnpm run runners && pnpm run typecheck && NO_BRIDGE=1 astro build && pnpm run check:links && pnpm run check:bridge",
    "bridge": "node scripts/bridge.ts",
    "check:bridge": "node scripts/check-no-bridge.ts",
    "build:quick": "pnpm run runners && astro build",
    "check:links": "node scripts/check-links.mts",
    "preview": "node scripts/preview.ts",
    "posters": "node scripts/posters.ts",
    "prune": "node scripts/prune-runners.ts",
    "astro": "astro",
    "prettier": "prettier . --check",
    "prettier:write": "prettier . --write",
    "lint": "eslint . ",
    "lint:fix": "eslint . --fix",
    "typecheck": "astro check",
    "test": "pnpm run test:unit && pnpm run test:browser",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:headed": "playwright test --headed",
    "runners": "node scripts/runners.ts",
    "test:affected": "node scripts/affected.ts",
    "probe": "vitest run --config vitest.probe.config.mts",
    "shot": "node scripts/shot.ts"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/exo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/rubik": "^5.3.0",
    "@fontsource/source-sans-pro": "^5.3.0",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "astro-icon": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "astro-eslint-parser": "^3.2.0",
    "baseline-browser-mapping": "^2.11.29",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@11.25.0"
}
