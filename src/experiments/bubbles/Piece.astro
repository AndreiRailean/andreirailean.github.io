---
import PiecePage from "@/experiments/gallery/PiecePage.astro"
import type { NoteTheme } from "@/experiments/gallery/NoteOverlay.astro"
import { PRESETS } from "@/experiments/bubbles/presets"

// The note's furniture is the gallery's; only the paint is this piece's. See
// docs/adr/20260828-the-piece-is-independent-the-gallery-is-not.

// Read off the primary rather than written down, so promoting a preset moves the
// note's accent along with the poster and the landing scene. Every instance of
// this fault in the section was a hue typed as a literal, correct on the day.
//
// `bg` is the one field that is *not* turned from the hue, and that is the piece
// rather than an oversight: the water is black, exactly, and the whole premise
// is that a viewer sees white circles and nothing else. A tinted ground behind
// the sheet would be a second opinion about a colour the piece has decided it
// does not have.
const primary = PRESETS[0]!.settings
const { hue } = primary
const theme = {
  bg: "#000",
  sheet: `hsl(${hue} 40% 4% / 78%)`,
  fg: `hsl(${hue} 14% 86%)`,
  bright: `hsl(${hue} 22% 97%)`,
  muted: `hsl(${hue} 12% 58%)`,
  edge: `hsl(${hue} 28% 82% / 12%)`,
  accent: `hsl(${hue} 72% 64%)`,
} satisfies NoteTheme

interface Props {
  /** Render with the note already open, for the note's own address. */
  note?: boolean
}

const { note = false } = Astro.props
---

<PiecePage slug="bubbles" note={note} theme={theme} backdrop={0.5}>
  <style is:global>
    html {
      /* Overridden from JS on every change; the fallback keeps the page sane
           before the first paint and without script. The water itself takes no
           colour from this — it is black, and the bubbles are white. */
      --hue: 190;

      --accent: hsl(var(--hue) 72% 62%);
      --ui-text: rgb(255 255 255 / 74%);
      --ui-label: rgb(255 255 255 / 50%);
      --ui-heading: hsl(var(--hue) 36% 68%);
      --ui-panel: rgb(4 8 10 / 86%);
      --ui-chip: rgb(6 12 15 / 76%);
      --ui-edge: rgb(215 240 255 / 14%);
      --ui-edge-hover: rgb(215 240 255 / 34%);
      --ui-on-bg: hsl(var(--hue) 58% 32%);
      --ui-on-text: hsl(var(--hue) 70% 94%);
      --ui-on-edge: rgb(200 235 255 / 42%);
      --track: rgb(215 240 255 / 16%);
      --ui-fade: 0.35s;

      /* The kit's measures, which the pieces legitimately disagree about:
           twenty-seven rows in four groups want a wider panel than fifteen. */
      --ui-label-col: 6.5rem;
      --ui-value-col: 5.5rem;
      --ui-panel-min: 23rem;
      --ui-row-gap: 0.38rem;
    }

    html,
    body {
      margin: 0;
      height: 100%;
      /* The water. Everything a viewer can see that is not a bubble is this. */
      background: #000;
    }

    body {
      overflow: hidden;
    }

    canvas {
      position: fixed;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
    }
  </style>
  <canvas id="water"></canvas>
  <script>
    import { boot } from "@/experiments/gallery/boot"
    import * as settings from "@/experiments/bubbles/settings"
    import { PRESETS } from "@/experiments/bubbles/presets"
    import { start } from "@/experiments/bubbles/runner"

    boot({ settings, presets: PRESETS, start })
  </script>
</PiecePage>
