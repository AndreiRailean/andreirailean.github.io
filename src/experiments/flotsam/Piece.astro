---
import PiecePage from "@/experiments/gallery/PiecePage.astro"
import type { NoteTheme } from "@/experiments/gallery/NoteOverlay.astro"
import { PRESETS } from "@/experiments/flotsam/settings"

// The note's furniture is the gallery's; only the paint is Flotsam's. See
// docs/adr/20260828-the-piece-is-independent-the-gallery-is-not.

// Taken from the primary rather than written down. This one reads the same
// either way today — `offing` and the defaults are both hue 202 — which is
// exactly why it was worth changing: agreement that nothing holds is the state
// Dangler was in until its defaults moved. Saturation and lightness stay
// Flotsam's own. See CONTEXT.md on *primary*.
const primary = PRESETS[0]!.settings

const theme: NoteTheme = {
  bg: "#04080b",
  sheet: "rgb(4 8 11 / 80%)",
  fg: "#d2d8da",
  bright: "#f0f5f6",
  muted: "#7f8a8e",
  edge: "rgb(255 255 255 / 11%)",
  accent: `hsl(${primary.hue}, 54%, 68%)`,
}

interface Props {
  /** Render with the note already open, for the note's own address. */
  note?: boolean
}

const { note = false } = Astro.props
---

<PiecePage slug="flotsam" note={note} theme={theme} backdrop={0.45}>
  <style is:global>
    /* Dark only. The subject is a few lit things on black water; inverted it
         would be dark dots on white, which is a different piece. */
    html {
      --ground: #04080b;
      --accent: hsl(202, 58%, 62%);
      --ui-text: rgb(255 255 255 / 72%);
      --ui-label: rgb(255 255 255 / 50%);
      --ui-heading: rgb(255 255 255 / 34%);
      --ui-panel: rgb(6 12 16 / 84%);
      --ui-chip: rgb(8 14 19 / 74%);
      --ui-edge: rgb(255 255 255 / 12%);
      --ui-edge-hover: rgb(255 255 255 / 30%);
      --ui-on-bg: hsl(202, 38%, 38%);
      --ui-on-text: hsl(202, 60%, 95%);
      --ui-on-edge: rgb(255 255 255 / 38%);
      --track: rgb(255 255 255 / 16%);
      --ui-fade: 0.35s;

      /* The kit's own measures, which the pieces legitimately disagree
           about: a panel of fifteen rows and one of twenty-seven do not
           want the same widths. */
      --ui-label-col: 6.75rem;
      --ui-value-col: 5.25rem;
      --ui-panel-min: 23rem;
      --ui-row-gap: 0.26rem;
    }

    html,
    body {
      margin: 0;
      height: 100%;
      background: var(--ground);
    }

    body {
      overflow: hidden;
    }

    canvas {
      position: fixed;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
    }
  </style>
  <canvas id="water"></canvas>
  <script>
    import { boot } from "@/experiments/flotsam/page"

    boot()
  </script>
</PiecePage>
