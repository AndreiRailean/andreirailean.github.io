---
import PiecePage from "@/experiments/gallery/PiecePage.astro"
import type { NoteTheme } from "@/experiments/gallery/NoteOverlay.astro"
import { PRESETS } from "@/experiments/embers/settings"
import { groundColour } from "@/experiments/embers/draw"

// The note's furniture is the gallery's; only the paint is this piece's. See
// docs/adr/20260828-the-piece-is-independent-the-gallery-is-not.

// Read off the primary rather than written down, so promoting a preset moves the
// note's accent along with the poster and the landing scene. Every instance of
// this fault in the section was a hue typed as a literal, correct on the day.
//
// **And not only the accent.** The rest of the sheet was a set of warm
// near-blacks and creams, which was right while every preset was a fire and
// wrong the moment the primary was `winter blues` — a blue one. A derived accent
// on furniture that cannot move with it is the same staleness the section
// already refuses, one field over: the note came out warm brown around a cold
// blue piece. So the whole theme turns with the hue now, and `bg` is the piece's
// own ground colour rather than a second opinion about it.
const primary = PRESETS[0]!.settings
const { hue } = primary
const theme = {
  bg: groundColour(hue),
  sheet: `hsl(${hue} 45% 4% / 76%)`,
  fg: `hsl(${hue} 16% 85%)`,
  bright: `hsl(${hue} 24% 96%)`,
  muted: `hsl(${hue} 13% 57%)`,
  edge: `hsl(${hue} 30% 82% / 12%)`,
  accent: `hsl(${hue} 82% 62%)`,
} satisfies NoteTheme

interface Props {
  /** Render with the note already open, for the note's own address. */
  note?: boolean
}

const { note = false } = Astro.props
---

<PiecePage slug="embers" note={note} theme={theme} backdrop={0.5}>
  <style is:global>
    html {
      /* Both overridden from JS on every change; the fallbacks keep the page
           sane before the first paint and without script. `--ground` is the
           same near-black the canvas fades toward, so a cold landing is not a
           black rectangle inside a warm document. */
      --hue: 25;
      --ground: hsl(25 55% 2.6%);

      --accent: hsl(var(--hue) 78% 58%);
      --ui-text: rgb(255 255 255 / 72%);
      --ui-label: rgb(255 255 255 / 50%);
      --ui-heading: hsl(var(--hue) 40% 66%);
      --ui-panel: rgb(14 8 6 / 84%);
      --ui-chip: rgb(18 11 8 / 74%);
      --ui-edge: rgb(255 235 215 / 13%);
      --ui-edge-hover: rgb(255 235 215 / 32%);
      --ui-on-bg: hsl(var(--hue) 62% 34%);
      --ui-on-text: hsl(var(--hue) 70% 94%);
      --ui-on-edge: rgb(255 225 195 / 40%);
      --track: rgb(255 235 215 / 15%);
      --ui-fade: 0.35s;

      /* The kit's measures, which the pieces legitimately disagree about:
           twenty-seven rows in four groups want a wider panel than fifteen. */
      --ui-label-col: 6.5rem;
      --ui-value-col: 5.25rem;
      --ui-panel-min: 23rem;
      --ui-row-gap: 0.38rem;
    }

    html,
    body {
      margin: 0;
      height: 100%;
      background: var(--ground);
    }

    body {
      overflow: hidden;
    }

    canvas {
      position: fixed;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
    }
  </style>
  <canvas id="fire"></canvas>
  <script>
    import { boot } from "@/experiments/embers/page"

    boot()
  </script>
</PiecePage>
