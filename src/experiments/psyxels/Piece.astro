---
import PiecePage from "@/experiments/gallery/PiecePage.astro"
import type { NoteTheme } from "@/experiments/gallery/NoteOverlay.astro"
import { PRESETS } from "@/experiments/psyxels/presets"

// The portrait is not imported here any more. It is a picture at an address
// now — `LOCAL_PORTRAIT` in `subject.ts`, served from `public/` — and the
// address travels in the scene like any other setting (#263).

// The note's furniture is the gallery's; only the paint is Psyxels'. See
// docs/adr/20260828-the-piece-is-independent-the-gallery-is-not.

// Taken from the primary rather than written down. This read `hsl(286, …)`,
// which is `DEFAULT_SETTINGS.hue` — while the backdrop below correctly runs the
// primary, `alive`, at 260. So the furniture was 26° off the field it sits on,
// the same fault Dangler had at 198°, from the same cause: an accent copied
// from the defaults, which nothing presentational should read. Saturation and
// lightness stay Psyxels' own. See CONTEXT.md on *primary*.
const primary = PRESETS[0]!.settings

const theme: NoteTheme = {
  bg: "#05050a",
  sheet: "rgb(5 5 10 / 82%)",
  fg: "#d6d3de",
  bright: "#f4f1f8",
  muted: "#867f92",
  edge: "rgb(255 255 255 / 12%)",
  accent: `hsl(${primary.hue}, 62%, 74%)`,
}

interface Props {
  /** Render with the note already open, for the note's own address. */
  note?: boolean
}

const { note = false } = Astro.props
---

<PiecePage slug="psyxels" note={note} theme={theme} backdrop={0.4}>
  <style is:global>
    /* Dark only. The subject is light on an unlit ground and the ground is
         genuinely empty — inverted, the black would become a subject of its own
         and the piece would be about something else. */
    html {
      --ground: #05050a;
      --accent: hsl(286, 70%, 66%);
      --ui-text: rgb(255 255 255 / 74%);
      --ui-label: rgb(255 255 255 / 52%);
      --ui-heading: rgb(255 255 255 / 34%);
      --ui-panel: rgb(9 7 15 / 86%);
      --ui-chip: rgb(12 9 19 / 76%);
      --ui-edge: rgb(255 255 255 / 13%);
      --ui-edge-hover: rgb(255 255 255 / 32%);
      --ui-on-bg: hsl(286, 42%, 40%);
      --ui-on-text: hsl(286, 70%, 96%);
      --ui-on-edge: rgb(255 255 255 / 40%);
      --track: rgb(255 255 255 / 16%);
      --ui-fade: 0.35s;

      /* Twenty-one rows under four headings. The labels are single words, so
           the name column is narrower than Flotsam's. */
      --ui-label-col: 6.5rem;
      --ui-value-col: 5rem;
      /* A box is this wide, border-box, so it is the widest row plus the box's
         padding. It was 28rem while the subject was a row of six choices; typed
         text took that row away (#263), and the glyphs row is the widest now. `tests/kit.spec.ts` holds it (#257). */
      --ui-panel-min: 25.5rem;
      --ui-row-gap: 0.26rem;
    }

    html,
    body {
      margin: 0;
      height: 100%;
      background: var(--ground);
    }

    body {
      overflow: hidden;
    }

    canvas {
      position: fixed;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
    }
  </style>
  <canvas id="stage"></canvas>
  <script>
    import { boot } from "@/experiments/gallery/boot"
    import * as settings from "@/experiments/psyxels/settings"
    import { PRESETS } from "@/experiments/psyxels/presets"
    import { start } from "@/experiments/psyxels/runner"

    boot({ settings, presets: PRESETS, start })
  </script>
</PiecePage>
