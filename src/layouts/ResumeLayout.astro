---
import MetaTags from "@/components/MetaTags.astro"
import GoogleAnalytics from "@/components/GoogleAnalytics.astro"

import "@/styles/globals.css"
import "@/styles/resume.css"
import "@fontsource-variable/inter"
import "@fontsource-variable/exo"
import "@fontsource/source-sans-pro"
import "@fontsource-variable/rubik"

type Props = {
  frontmatter: {
    title: string
    noIndex?: boolean
    description?: string
  }
}

const { FORCE_THEME = "" } = import.meta.env

const { title, noIndex, description } = Astro.props.frontmatter as Props["frontmatter"]

const pubDate = new Date().toLocaleDateString("en-AU", {
  year: "numeric",
  month: "long",
  day: "numeric",
})

const pageTitle = `${title} - ${pubDate}`
---

<!doctype html>
<html lang="en" class={FORCE_THEME}>
  <head>
    <MetaTags title={pageTitle} description={description || title} noIndex={noIndex} />
    <GoogleAnalytics />
  </head>
  <body>
    <div class="container mx-auto flex justify-center">
      <article class="minimalist relative">
        <slot />
      </article>
    </div>
  </body>
</html>
