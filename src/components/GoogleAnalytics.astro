---
// The measurement ID is not a secret: it ships in the page source of every site
// that uses GA, and it lived in this file as a literal from 2024. It was moved
// to PUBLIC_GA_TRACKING_ID in July 2025, but that variable only ever existed in
// a local .envrc — CI built with it undefined, so the site asked Google for
// `?id=undefined` for over a year and recorded nothing. A constant cannot drift
// out of the deploy environment the way an unset variable did.
const GA_MEASUREMENT_ID = "G-LCDC2KKGVY"

// Null outside a production build, which the script below treats as "do
// nothing": `astro dev` and the test suite should not report into the real
// property. `astro preview` serves a production build, so it does count.
const gaTrackingId = import.meta.env.PROD ? GA_MEASUREMENT_ID : null
---

<script async is:inline define:vars={{ gaTrackingId }}>
  // Guarded rather than returned early: the compiler rejects a top-level
  // return here, even though the emitted script is wrapped in a function.
  if (gaTrackingId) {
    // Define dataLayer and gtag function.
    window.dataLayer = window.dataLayer || []
    function gtag() {
      dataLayer.push(arguments) // eslint-disable-line
    }

    // Advertising storage stays denied; nothing here advertises. Analytics
    // storage is granted, which is the state the site has been configured for
    // since the consent banner was removed in July 2025.
    gtag("consent", "default", {
      ad_storage: "denied",
      ad_user_data: "denied",
      ad_personalization: "denied",
      analytics_storage: "granted",
    })

    // Load the Google Analytics script.
    const gascript = document.createElement("script")
    gascript.src = `https://www.googletagmanager.com/gtag/js?id=${gaTrackingId}`
    gascript.async = true
    document.head.appendChild(gascript)

    // Initialize Google Analytics.
    gtag("js", new Date())
    gtag("config", gaTrackingId)
  }
</script>
