---
import ThemeToggle from "@/components/ThemeToggle.astro"

// Fixed, so the toggle sits over the page rather than reserving a 4rem strip at
// the bottom of it. It is a control, not a section, and letting it size a footer
// meant every page was centred around it.
---

<footer class="fixed right-2 bottom-2 z-50">
  <ThemeToggle />
</footer>
