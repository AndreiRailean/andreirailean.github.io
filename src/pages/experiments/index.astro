---
import { getCollection } from "astro:content"

// Deliberately no site Layout: the experiments section is its own place and
// will get its own theme eventually. Kept minimal so it imposes nothing on the
// experiments it lists.
const experiments = (await getCollection("experiments")).sort(
  (a, b) => b.data.updated.valueOf() - a.data.updated.valueOf(),
)

const formatDate = (date: Date) => date.toLocaleDateString("en-GB", { month: "short", year: "numeric" })
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Experiments</title>
    <meta name="description" content="Programmed graphics. Each one runs full-screen and stands on its own." />
    <style is:global>
      :root {
        color-scheme: light dark;
        --bg: #fbfbfc;
        --fg: #14161c;
        --muted: #6a7080;
        --edge: rgb(20 22 28 / 12%);
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0b0d12;
          --fg: #e9ebf2;
          --muted: #8b93a6;
          --edge: rgb(255 255 255 / 14%);
        }
      }

      html,
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
      }

      body {
        font:
          400 1rem/1.6 ui-sans-serif,
          system-ui,
          -apple-system,
          "Segoe UI",
          sans-serif;
        padding: clamp(2rem, 8vh, 6rem) 1.5rem;
      }

      main {
        max-width: 44rem;
        margin: 0 auto;
      }

      h1 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 500;
        letter-spacing: -0.01em;
      }

      .lede {
        margin: 0.5rem 0 3rem;
        color: var(--muted);
      }

      ul {
        margin: 0;
        padding: 0;
        list-style: none;
      }

      li + li {
        margin-top: 0.5rem;
        border-top: 1px solid var(--edge);
        padding-top: 2rem;
      }

      li {
        padding-bottom: 1.5rem;
      }

      .name {
        font-size: 1.15rem;
        font-weight: 500;
        color: inherit;
        text-decoration: none;
      }

      .name:hover {
        text-decoration: underline;
        text-underline-offset: 0.2em;
      }

      .summary {
        margin: 0.4rem 0 0.75rem;
      }

      .meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: baseline;
        font-size: 0.8125rem;
        color: var(--muted);
      }

      .meta a {
        color: inherit;
      }

      .empty {
        color: var(--muted);
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Experiments</h1>
      <p class="lede">Programmed graphics. Each one takes the whole window and stands on its own.</p>

      {
        experiments.length === 0 ? (
          <p class="empty">Nothing here yet.</p>
        ) : (
          <ul>
            {experiments.map(({ data }) => (
              <li>
                <a class="name" href={`/experiments/${data.slug}/`}>
                  {data.title}
                </a>
                <p class="summary">{data.summary}</p>
                <p class="meta">
                  <span>
                    <time datetime={data.started.toISOString()}>{formatDate(data.started)}</time>
                    {formatDate(data.updated) !== formatDate(data.started) && (
                      <>
                        {" · updated "}
                        <time datetime={data.updated.toISOString()}>{formatDate(data.updated)}</time>
                      </>
                    )}
                  </span>
                  <a href={`/experiments/${data.slug}/about/`}>about</a>
                </p>
              </li>
            ))}
          </ul>
        )
      }
    </main>
  </body>
</html>
