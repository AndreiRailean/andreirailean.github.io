---
// A deliberately bare document: no Layout, no globals.css, no Tailwind. The
// experiment owns the whole viewport and shares no chrome with the rest of the
// site.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Starry Night</title>
    <style is:global>
      html,
      body {
        margin: 0;
        height: 100%;
        background: #05070f;
      }

      body {
        overflow: hidden;
        --ui-fade: 0.35s;
      }

      /* Pointer and controls both disappear together, like video chrome. */
      body[data-idle="true"] {
        cursor: none;
      }

      canvas {
        position: fixed;
        inset: 0;
        display: block;
        width: 100%;
        height: 100%;
      }

      #ui {
        position: fixed;
        right: 1.25rem;
        bottom: 1.25rem;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.5rem;
        font:
          400 0.75rem/1.5 ui-monospace,
          "SF Mono",
          Menlo,
          monospace;
        letter-spacing: 0.03em;
        color: rgb(255 255 255 / 70%);
        transition:
          opacity var(--ui-fade) ease-out,
          transform var(--ui-fade) ease-out;
      }

      body[data-idle="true"] #ui {
        opacity: 0;
        transform: translateY(0.4rem);
        pointer-events: none;
      }

      .bar {
        display: flex;
        gap: 0.35rem;
      }

      #ui button {
        margin: 0;
        padding: 0.3rem 0.6rem;
        font: inherit;
        letter-spacing: inherit;
        color: inherit;
        cursor: pointer;
        background: rgb(12 16 30 / 72%);
        border: 1px solid rgb(255 255 255 / 12%);
        border-radius: 0.3rem;
        backdrop-filter: blur(6px);
      }

      #ui button:hover {
        border-color: rgb(255 255 255 / 30%);
      }

      #ui button[data-active="true"] {
        color: #eaf0ff;
        background: rgb(60 80 140 / 55%);
        border-color: rgb(255 255 255 / 38%);
      }

      .panel {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        min-width: 20rem;
        padding: 0.75rem 0.85rem;
        background: rgb(10 14 26 / 82%);
        border: 1px solid rgb(255 255 255 / 12%);
        border-radius: 0.4rem;
        backdrop-filter: blur(8px);
      }

      /* An author `display` beats the UA's [hidden] rule, so state it here. */
      .panel[hidden] {
        display: none;
      }

      .row {
        display: grid;
        grid-template-columns: 5rem 1fr 3.5rem;
        align-items: center;
        gap: 0.6rem;
      }

      .label {
        color: rgb(255 255 255 / 52%);
      }

      .value {
        text-align: right;
        font-variant-numeric: tabular-nums;
      }

      .modes {
        display: flex;
        grid-column: 2 / span 2;
        gap: 0.3rem;
      }

      .row.copy {
        grid-template-columns: 1fr;
        margin-top: 0.2rem;
      }

      .row.copy button {
        width: 100%;
      }

      input[type="range"] {
        width: 100%;
        height: 1rem;
        margin: 0;
        accent-color: #7f9be0;
        cursor: pointer;
        background: transparent;
      }

      @media (prefers-reduced-motion: reduce) {
        #ui {
          transition: none;
        }
      }
    </style>
  </head>
  <body>
    <canvas id="sky"></canvas>
    <div id="ui"></div>

    <script>
      import { createStarfield } from "@/experiments/starry-night/starfield"
      import { createControls } from "@/experiments/starry-night/controls"
      import { settingsFromQuery } from "@/experiments/starry-night/settings"

      function requireElement<T extends Element>(id: string, type: new () => T): T {
        const element = document.getElementById(id)
        if (!(element instanceof type)) {
          throw new Error(`Starry Night: missing #${id}`)
        }
        return element
      }

      const canvas = requireElement("sky", HTMLCanvasElement)
      const ui = requireElement("ui", HTMLDivElement)

      const settings = settingsFromQuery(new URLSearchParams(window.location.search))

      const sky = createStarfield(canvas, settings)
      sky.start()

      createControls({
        root: ui,
        settings,
        onChange: (next) => sky.setSettings(next),
      })
    </script>
  </body>
</html>
