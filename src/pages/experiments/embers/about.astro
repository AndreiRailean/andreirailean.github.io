---
import { getCollection } from "astro:content"
import Note, { type NoteTheme } from "@/experiments/gallery/Note.astro"
import { PRESETS } from "@/experiments/embers/settings"

// The note's furniture is the gallery's; only the paint is this piece's. See
// docs/adr/20260828-the-piece-is-independent-the-gallery-is-not.
const entry = (await getCollection("experiments")).find(({ data }) => data.slug === "embers")
if (!entry) throw new Error("Embers: missing about.md")

// Read off the primary rather than written down, so promoting a preset moves the
// note's accent along with the poster and the landing scene. Every instance of
// this fault in the section was a hue typed as a literal, correct on the day.
const primary = PRESETS[0]!.settings
---

<Note
  entry={entry}
  theme={{
    bg: "#0a0605",
    sheet: "rgb(10 6 5 / 74%)",
    fg: "#e2d6cd",
    bright: "#fbf5f0",
    muted: "#9b8479",
    edge: "rgb(255 235 215 / 12%)",
    accent: `hsl(${primary.hue} 82% 62%)`,
  } satisfies NoteTheme}
  backdrop={0.5}
>
  <script>
    import { createEmbers } from "@/experiments/embers/embers"
    import { normalizeSettings, PRESETS } from "@/experiments/embers/settings"

    const canvas = document.getElementById("backdrop")
    if (canvas instanceof HTMLCanvasElement) {
      // Calmer than the piece proper: this one is scenery, not the subject. The
      // only things held to the primary are its hue and its *framing* —
      // everything else here is a deliberate turning-down, and taking the whole
      // preset would undo it.
      //
      // **The framing is not optional and is why it is read rather than
      // chosen.** A narrow fire makes a column up the middle of the page, which
      // is exactly where the note's sheet sits, so the backdrop was a piece you
      // could not see. The primary is a bed wider than the frame for that
      // reason: it lays light along the bottom of the page, under the text
      // rather than behind it.
      const primary = PRESETS[0]!.settings
      const fire = createEmbers(
        canvas,
        normalizeSettings({
          hue: primary.hue,
          span: primary.span,
          bed: primary.bed,
          hearth: primary.hearth,
          sputter: 0.4,
          pops: 0.15,
          bursts: 2,
          updraft: 2.2,
          count: 700,
          firelight: 0.05,
          wind: -1.1,
          gust: 0.3,
          exposure: 2,
          shutter: 0.06,
          playback: 0.12,
        }),
      )
      fire.start()
      // A backdrop is a still until it is looked at for a while, and this one
      // accumulates: without a run-up the sheet sits over an empty frame for the
      // first second of every visit.
      fire.settle(6)
    }
  </script>
</Note>
