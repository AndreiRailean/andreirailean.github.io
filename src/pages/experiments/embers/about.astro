---
import { getCollection } from "astro:content"
import Note, { type NoteTheme } from "@/experiments/gallery/Note.astro"
import { PRESETS } from "@/experiments/embers/settings"
import { groundColour } from "@/experiments/embers/draw"

// The note's furniture is the gallery's; only the paint is this piece's. See
// docs/adr/20260828-the-piece-is-independent-the-gallery-is-not.
const entry = (await getCollection("experiments")).find(({ data }) => data.slug === "embers")
if (!entry) throw new Error("Embers: missing about.md")

// Read off the primary rather than written down, so promoting a preset moves the
// note's accent along with the poster and the landing scene. Every instance of
// this fault in the section was a hue typed as a literal, correct on the day.
//
// **And not only the accent.** The rest of the sheet was a set of warm
// near-blacks and creams, which was right while every preset was a fire and
// wrong the moment the primary was `winter blues` — a blue one. A derived accent
// on furniture that cannot move with it is the same staleness the section
// already refuses, one field over: the note came out warm brown around a cold
// blue piece. So the whole theme turns with the hue now, and `bg` is the piece's
// own ground colour rather than a second opinion about it.
const primary = PRESETS[0]!.settings
const { hue } = primary
---

<Note
  entry={entry}
  theme={{
    bg: groundColour(hue),
    sheet: `hsl(${hue} 45% 4% / 76%)`,
    fg: `hsl(${hue} 16% 85%)`,
    bright: `hsl(${hue} 24% 96%)`,
    muted: `hsl(${hue} 13% 57%)`,
    edge: `hsl(${hue} 30% 82% / 12%)`,
    accent: `hsl(${hue} 82% 62%)`,
  } satisfies NoteTheme}
  backdrop={0.5}
>
  <script>
    import { createEmbers } from "@/experiments/embers/embers"
    import { normalizeSettings, PRESETS } from "@/experiments/embers/settings"

    const canvas = document.getElementById("backdrop")
    if (canvas instanceof HTMLCanvasElement) {
      // **The primary, turned down — spread rather than sampled.**
      //
      // This used to pick six fields off the primary and write the rest out,
      // and that quietly stopped being the primary at all: `winter blues` is
      // soft blue motes at a flare of 0.5, and the backdrop was drawing tailed
      // embers at 1.5 with a different size range, a different heat and a hue
      // spread the scene does not have. A visitor met one piece on the note and
      // another behind it.
      //
      // So everything comes from the primary and only the *busyness* is turned
      // down. This is scenery: it sits under a sheet of text, it should not
      // compete with it, and it should still be recognisably the thing the page
      // is about.
      //
      // The framing in particular is not optional. A narrow fire makes a column
      // up the middle of the page, which is exactly where the sheet sits — so
      // the backdrop was a piece you could not see. A bed wider than the frame
      // lays light along the bottom instead, under the text rather than behind
      // it.
      const primary = PRESETS[0]!.settings
      const fire = createEmbers(
        canvas,
        normalizeSettings({
          ...primary,
          count: Math.round(primary.count * 0.55),
          sputter: primary.sputter * 0.35,
          pops: primary.pops * 0.25,
          bursts: primary.bursts * 0.4,
          playback: 0.12,
        }),
      )
      fire.start()
      // A backdrop is a still until it is looked at for a while, and this one
      // accumulates: without a run-up the sheet sits over an empty frame for the
      // first second of every visit.
      fire.settle(6)
    }
  </script>
</Note>
