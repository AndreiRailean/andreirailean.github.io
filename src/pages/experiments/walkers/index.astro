---
import "@/experiments/kit/controls.css"

import Reel from "@/experiments/gallery/Reel.astro"

// A deliberately bare document: no Layout, no globals.css, no Tailwind. The
// experiment owns the whole viewport and shares no chrome with the rest of the
// site.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Walkers</title>
    <style is:global>
      /* The ground is pale by day and dark at dusk, so the chrome has to be
         both ways round. Two sets of tokens, swapped by one attribute, exactly
         as Starry Night does for its inverted sky. */
      html {
        /* Overridden from JS; the fallback keeps the page sane without script. */
        --hue: 104;
        --accent: hsl(var(--hue), 34%, 34%);
        --ground: #9db98a;
        --ui-text: rgb(18 24 16 / 82%);
        --ui-label: rgb(18 24 16 / 56%);
        --ui-heading: rgb(18 24 16 / 46%);
        --ui-panel: rgb(255 255 255 / 84%);
        --ui-chip: rgb(255 255 255 / 76%);
        --ui-edge: rgb(18 24 16 / 14%);
        --ui-edge-hover: rgb(18 24 16 / 34%);
        --ui-on-bg: hsl(var(--hue), 30%, 74%);
        --ui-on-text: hsl(var(--hue), 42%, 16%);
        --ui-on-edge: rgb(18 24 16 / 32%);
        --track: rgb(18 24 16 / 15%);
        --ui-fade: 0.35s;

        /* Twenty-three rows, several of them long-named, so the label column is
           wider than Starry Night's and the panel is taller. */
        --ui-label-col: 5.5rem;
        --ui-value-col: 5.25rem;
        --ui-panel-min: 21rem;
        --ui-row-gap: 0.36rem;
      }

      html[data-dusk="true"] {
        --accent: hsl(var(--hue), 30%, 66%);
        --ground: #1d2418;
        --ui-text: rgb(255 255 255 / 74%);
        --ui-label: rgb(255 255 255 / 52%);
        --ui-heading: rgb(255 255 255 / 44%);
        --ui-panel: rgb(14 18 12 / 82%);
        --ui-chip: rgb(16 20 14 / 74%);
        --ui-edge: rgb(255 255 255 / 13%);
        --ui-edge-hover: rgb(255 255 255 / 32%);
        --ui-on-bg: hsl(var(--hue), 26%, 40%);
        --ui-on-text: hsl(var(--hue), 45%, 93%);
        --ui-on-edge: rgb(255 255 255 / 36%);
        --track: rgb(255 255 255 / 16%);
      }

      html,
      body {
        margin: 0;
        height: 100%;
        background: var(--ground);
      }

      body {
        overflow: hidden;
      }

      canvas {
        position: fixed;
        inset: 0;
        display: block;
        width: 100%;
        height: 100%;
      }
    </style>
  </head>
  <body>
    <canvas id="park"></canvas>
    {
      /* The interactive view: full-bleed piece, two axes of swipe, on a touch device.
        Between the canvas and `#ui` because DOM order is the whole stacking
        arrangement here — see the note in Reel.astro. */
    }
    <Reel slug="walkers" />
    <div id="ui"></div>

    <script>
      import { boot } from "@/experiments/walkers/page"

      boot()
    </script>
  </body>
</html>
