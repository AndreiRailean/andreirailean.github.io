---
import "@/experiments/kit/controls.css"

import Reel from "@/experiments/gallery/Reel.astro"

// A deliberately bare document: no Layout, no globals.css, no Tailwind. The
// experiment owns the whole viewport and shares no chrome with the rest of the
// site.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Flotsam</title>
    <meta
      name="description"
      content="Specks on dark water, seen from above, shaken by waves that never take them anywhere."
    />
    <style is:global>
      /* Dark only. The subject is a few lit things on black water; inverted it
         would be dark dots on white, which is a different piece. */
      html {
        --ground: #04080b;
        --accent: hsl(202, 58%, 62%);
        --ui-text: rgb(255 255 255 / 72%);
        --ui-label: rgb(255 255 255 / 50%);
        --ui-heading: rgb(255 255 255 / 34%);
        --ui-panel: rgb(6 12 16 / 84%);
        --ui-chip: rgb(8 14 19 / 74%);
        --ui-edge: rgb(255 255 255 / 12%);
        --ui-edge-hover: rgb(255 255 255 / 30%);
        --ui-on-bg: hsl(202, 38%, 38%);
        --ui-on-text: hsl(202, 60%, 95%);
        --ui-on-edge: rgb(255 255 255 / 38%);
        --track: rgb(255 255 255 / 16%);
        --ui-fade: 0.35s;

        /* The kit's own measures, which the pieces legitimately disagree
           about: a panel of fifteen rows and one of twenty-seven do not
           want the same widths. */
        --ui-label-col: 6.75rem;
        --ui-value-col: 5.25rem;
        --ui-panel-min: 23rem;
        --ui-row-gap: 0.26rem;
      }

      html,
      body {
        margin: 0;
        height: 100%;
        background: var(--ground);
      }

      body {
        overflow: hidden;
      }

      canvas {
        position: fixed;
        inset: 0;
        display: block;
        width: 100%;
        height: 100%;
      }
    </style>
  </head>
  <body>
    <canvas id="water"></canvas>
    {
      /* The interactive view: full-bleed piece, two axes of swipe, on a touch device.
        Between the canvas and `#ui` because DOM order is the whole stacking
        arrangement here — see the note in Reel.astro. */
    }
    <Reel slug="flotsam" />
    <div id="ui"></div>

    <script>
      import { boot } from "@/experiments/flotsam/page"

      boot()
    </script>
  </body>
</html>
