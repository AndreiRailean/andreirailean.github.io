---
import { getCollection } from "astro:content"
import Note, { type NoteTheme } from "@/experiments/gallery/Note.astro"

// The note's furniture is the gallery's; only the paint is Dangler's. See
// docs/adr/20260828-the-piece-is-independent-the-gallery-is-not.
const entry = (await getCollection("experiments")).find(({ data }) => data.slug === "dangler")
if (!entry) throw new Error("Dangler: missing about.md")

const theme: NoteTheme = {
  bg: "#05070c",
  sheet: "rgb(5 7 12 / 78%)",
  fg: "#d9d5cc",
  bright: "#f6f2ea",
  muted: "#8a8377",
  edge: "rgb(255 255 255 / 11%)",
  accent: "hsl(38, 58%, 66%)",
}
---

<Note entry={entry} theme={theme} backdrop={0.5}>
  <script>
    import { createDangler } from "@/experiments/dangler/dangler"
    import { DEFAULT_SETTINGS } from "@/experiments/dangler/settings"

    const canvas = document.getElementById("backdrop")
    if (canvas instanceof HTMLCanvasElement) {
      // The defaults, unmodified. They are a recorded scene rather than the
      // simplest thing the machinery can draw, precisely so that anything
      // rendering the piece without choosing — this page — gets something worth
      // looking at. See DEFAULT_SETTINGS.
      const scene = createDangler(canvas, DEFAULT_SETTINGS)
      scene.start()
    }
  </script>
</Note>
