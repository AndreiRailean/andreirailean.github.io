---
import "@/experiments/kit/controls.css"

import Reel from "@/experiments/gallery/Reel.astro"

// A deliberately bare document: no Layout, no globals.css, no Tailwind. The
// experiment owns the whole viewport and shares no chrome with the rest of the
// site.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dangler</title>
    <meta
      name="description"
      content="Strings of lights hanging from something unseen overhead, looked at from below."
    />
    <style is:global>
      /* No light scheme and no invert. Inverting a piece whose whole subject is
         emitted light gives dark dots on white, which is a different piece. */
      html {
        --ground: #05070c;
        --accent: hsl(38, 62%, 62%);
        --ui-text: rgb(255 255 255 / 72%);
        --ui-label: rgb(255 255 255 / 50%);
        --ui-heading: rgb(255 255 255 / 34%);
        --ui-panel: rgb(8 10 18 / 84%);
        --ui-chip: rgb(10 12 22 / 74%);
        --ui-edge: rgb(255 255 255 / 12%);
        --ui-edge-hover: rgb(255 255 255 / 30%);
        --ui-on-bg: hsl(38, 40%, 40%);
        --ui-on-text: hsl(38, 60%, 95%);
        --ui-on-edge: rgb(255 255 255 / 38%);
        --track: rgb(255 255 255 / 16%);
        --ui-fade: 0.35s;

        /* The kit's own measures, which the pieces legitimately disagree
           about: a panel of fifteen rows and one of twenty-seven do not
           want the same widths. */
        --ui-label-col: 6.75rem;
        --ui-value-col: 4.25rem;
        --ui-panel-min: 23rem;
        --ui-row-gap: 0.26rem;
      }

      html,
      body {
        margin: 0;
        height: 100%;
        background: var(--ground);
      }

      body {
        overflow: hidden;
      }

      canvas {
        position: fixed;
        inset: 0;
        display: block;
        width: 100%;
        height: 100%;
      }
    </style>
  </head>
  <body>
    <canvas id="lights"></canvas>
    {
      /* The interactive view: full-bleed piece, two axes of swipe, on a touch device.
        Between the canvas and `#ui` because DOM order is the whole stacking
        arrangement here — see the note in Reel.astro. */
    }
    <Reel slug="dangler" />
    <div id="ui"></div>

    <script>
      import { boot } from "@/experiments/dangler/page"

      boot()
    </script>
  </body>
</html>
