---
// A deliberately bare document: no Layout, no globals.css, no Tailwind. The
// experiment owns the whole viewport and shares no chrome with the rest of the
// site.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Starry Night</title>
    <style is:global>
      /* One set of tokens per scheme; inverting swaps the whole page, chrome
         included, so light-mode controls are not dark-on-light. */
      html {
        /* Overridden from JS; the fallback keeps the page sane without script. */
        --hue: 225;
        --accent: hsl(var(--hue), 40%, 62%);
        --sky-bg: #05070f;
        --ui-text: rgb(255 255 255 / 70%);
        --ui-label: rgb(255 255 255 / 52%);
        --ui-panel: rgb(10 14 26 / 82%);
        --ui-chip: rgb(12 16 30 / 72%);
        --ui-edge: rgb(255 255 255 / 12%);
        --ui-edge-hover: rgb(255 255 255 / 30%);
        --ui-on-bg: hsl(var(--hue), 34%, 42%);
        --ui-on-text: hsl(var(--hue), 55%, 94%);
        --ui-on-edge: rgb(255 255 255 / 38%);
        --track: rgb(255 255 255 / 16%);
        --ui-fade: 0.35s;
      }

      html[data-invert="true"] {
        --accent: hsl(var(--hue), 32%, 46%);
        --sky-bg: #f4f6fb;
        --ui-text: rgb(10 14 26 / 80%);
        --ui-label: rgb(10 14 26 / 55%);
        --ui-panel: rgb(255 255 255 / 84%);
        --ui-chip: rgb(255 255 255 / 78%);
        --ui-edge: rgb(10 14 26 / 14%);
        --ui-edge-hover: rgb(10 14 26 / 34%);
        --ui-on-bg: hsl(var(--hue), 42%, 78%);
        --ui-on-text: hsl(var(--hue), 40%, 18%);
        --ui-on-edge: rgb(10 14 26 / 32%);
        --track: rgb(10 14 26 / 15%);
      }

      html,
      body {
        margin: 0;
        height: 100%;
        background: var(--sky-bg);
      }

      body {
        overflow: hidden;
      }

      /* Pointer and controls disappear together, like video chrome. */
      html[data-idle="true"] {
        cursor: none;
      }

      canvas {
        position: fixed;
        inset: 0;
        display: block;
        width: 100%;
        height: 100%;
      }

      #ui {
        position: fixed;
        right: 1.25rem;
        bottom: 1.25rem;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.5rem;
        font:
          400 0.75rem/1.5 ui-monospace,
          "SF Mono",
          Menlo,
          monospace;
        letter-spacing: 0.03em;
        color: var(--ui-text);
        transition:
          opacity var(--ui-fade) ease-out,
          transform var(--ui-fade) ease-out;
      }

      html[data-idle="true"] #ui {
        opacity: 0;
        transform: translateY(0.4rem);
        pointer-events: none;
      }

      .bar {
        display: flex;
        gap: 0.35rem;
      }

      #ui a.about {
        text-decoration: none;
      }

      #ui button,
      #ui a.about {
        margin: 0;
        padding: 0.3rem 0.6rem;
        font: inherit;
        letter-spacing: inherit;
        color: inherit;
        cursor: pointer;
        background: var(--ui-chip);
        border: 1px solid var(--ui-edge);
        border-radius: 0.3rem;
        backdrop-filter: blur(6px);
      }

      #ui button:hover {
        border-color: var(--ui-edge-hover);
      }

      #ui button[data-active="true"] {
        color: var(--ui-on-text);
        background: var(--ui-on-bg);
        border-color: var(--ui-on-edge);
      }

      .panel {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        min-width: 20rem;
        padding: 0.75rem 0.85rem;
        background: var(--ui-panel);
        border: 1px solid var(--ui-edge);
        border-radius: 0.4rem;
        backdrop-filter: blur(8px);
      }

      /* An author `display` beats the UA's [hidden] rule, so state it here. */
      .panel[hidden] {
        display: none;
      }

      .row {
        display: grid;
        grid-template-columns: 5rem 1fr 4.75rem;
        align-items: center;
        gap: 0.6rem;
      }

      .label {
        color: var(--ui-label);
      }

      .value {
        text-align: right;
        font-variant-numeric: tabular-nums;
      }

      .modes {
        display: flex;
        grid-column: 2 / span 2;
        gap: 0.3rem;
      }

      .row.copy {
        grid-template-columns: 1fr;
        margin-top: 0.2rem;
      }

      .row.copy button {
        width: 100%;
      }

      /* The track is styled by hand rather than via accent-color. The UA derives
         the unfilled track and thumb contrast from the accent's perceived
         luminance, which varies hugely with hue at fixed lightness, so it flips
         to a contrasting scheme partway around the wheel. The track should stay
         muted against the background no matter what the hue is. */
      input[type="range"] {
        width: 100%;
        height: 1rem;
        margin: 0;
        cursor: pointer;
        background: transparent;
        -webkit-appearance: none;
        appearance: none;
      }

      input[type="range"]::-webkit-slider-runnable-track {
        height: 0.25rem;
        border-radius: 999px;
        /* Two hard stops fake the filled portion, which only Firefox gives us. */
        background: linear-gradient(to right, var(--accent) var(--fill, 0%), var(--track) var(--fill, 0%));
      }

      input[type="range"]::-webkit-slider-thumb {
        width: 0.7rem;
        height: 0.7rem;
        margin-top: -0.225rem;
        border: none;
        border-radius: 50%;
        background: var(--accent);
        -webkit-appearance: none;
        appearance: none;
      }

      input[type="range"]::-moz-range-track {
        height: 0.25rem;
        border-radius: 999px;
        background: var(--track);
      }

      input[type="range"]::-moz-range-progress {
        height: 0.25rem;
        border-radius: 999px;
        background: var(--accent);
      }

      input[type="range"]::-moz-range-thumb {
        width: 0.7rem;
        height: 0.7rem;
        border: none;
        border-radius: 50%;
        background: var(--accent);
      }

      /* Two handles on one axis. Both inputs overlay a single painted track;
         only the thumbs take pointer events, so whichever is grabbed is the one
         that moves and the track beneath stays a single continuous line. */
      .span {
        position: relative;
        height: 1rem;
      }

      .span::before,
      .span::after {
        content: "";
        position: absolute;
        top: 50%;
        height: 0.25rem;
        border-radius: 999px;
        transform: translateY(-50%);
      }

      .span::before {
        right: 0;
        left: 0;
        background: var(--track);
      }

      .span::after {
        right: calc(100% - var(--to, 100%));
        left: var(--from, 0%);
        background: var(--accent);
      }

      .span input[type="range"] {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }

      .span input[type="range"]::-webkit-slider-runnable-track {
        background: transparent;
      }

      .span input[type="range"]::-webkit-slider-thumb {
        pointer-events: auto;
      }

      .span input[type="range"]::-moz-range-track,
      .span input[type="range"]::-moz-range-progress {
        background: transparent;
      }

      .span input[type="range"]::-moz-range-thumb {
        pointer-events: auto;
      }

      @media (prefers-reduced-motion: reduce) {
        #ui {
          transition: none;
        }
      }
    </style>
  </head>
  <body>
    <canvas id="sky"></canvas>
    <div id="ui"></div>

    <script>
      import { createStarfield } from "@/experiments/starry-night/starfield"
      import { createControls } from "@/experiments/starry-night/controls"
      import { settingsFromQuery } from "@/experiments/starry-night/settings"
      import { announceApi, createApi } from "@/experiments/starry-night/api"
      import { keepAwake } from "@/experiments/starry-night/wakelock"

      function requireElement<T extends Element>(id: string, type: new () => T): T {
        const element = document.getElementById(id)
        if (!(element instanceof type)) {
          throw new Error(`Starry Night: missing #${id}`)
        }
        return element
      }

      const canvas = requireElement("sky", HTMLCanvasElement)
      const ui = requireElement("ui", HTMLDivElement)

      const settings = settingsFromQuery(new URLSearchParams(window.location.search))

      /**
       * The page owns document-level theming; the panel owns its own state.
       * Hue reaches the CSS as a custom property so the chrome picks up the
       * same colour as the clouds without duplicating the palette in script.
       */
      function applyTheme(next: { invert: boolean; hue: number }) {
        const root = document.documentElement
        root.dataset.invert = String(next.invert)
        root.style.setProperty("--hue", String(next.hue))
      }

      applyTheme(settings)

      const sky = createStarfield(canvas, settings)
      sky.start()

      const controls = createControls({
        root: ui,
        aboutHref: "/experiments/starry-night/about/",
        settings,
        onChange: (next) => {
          applyTheme(next)
          sky.setSettings(next)
        },
      })

      // Left running deliberately, so hold the display on.
      const wakeLock = keepAwake()

      // Console handle. See src/experiments/AGENTS.md.
      window.experiment = createApi(controls, wakeLock, sky)
      announceApi()

      // Two escape hatches for tools that cannot evaluate JS: ?panel=1 opens the
      // settings panel on load, ?idle=0 stops the chrome hiding itself. Neither
      // is a setting, so neither belongs in the shareable query string.
      const params = new URLSearchParams(window.location.search)
      if (params.get("panel") === "1") window.experiment.panel(true)
      const idleParam = params.get("idle")
      if (idleParam !== null) window.experiment.idle(idleParam !== "0")
    </script>
  </body>
</html>
