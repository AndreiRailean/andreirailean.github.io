---
import { getCollection } from "astro:content"
import Note, { type NoteTheme } from "@/experiments/gallery/Note.astro"

// The note's furniture is the gallery's; only the paint is Starry Night's. See
// docs/adr/20260828-the-piece-is-independent-the-gallery-is-not.
const entry = (await getCollection("experiments")).find(({ data }) => data.slug === "starry-night")
if (!entry) throw new Error("Starry Night: missing about.md")

const theme: NoteTheme = {
  bg: "#05070f",
  sheet: "rgb(6 8 17 / 72%)",
  fg: "#d6dbe8",
  bright: "#f2f5fb",
  muted: "#79839c",
  edge: "rgb(255 255 255 / 12%)",
  accent: "hsl(225, 40%, 68%)",
}
---

<Note entry={entry} theme={theme} backdrop={0.55}>
  <script>
    import { createStarfield } from "@/experiments/starry-night/starfield"
    import { normalizeSettings } from "@/experiments/starry-night/settings"

    const canvas = document.getElementById("backdrop")
    if (canvas instanceof HTMLCanvasElement) {
      // Calmer than the piece proper: this one is scenery, not the subject.
      const sky = createStarfield(
        canvas,
        normalizeSettings({
          densityScale: 0.7,
          nearRadius: 2.2,
          clouds: 0.12,
          hue: 247,
          glimmersPerSecond: 0.25,
          minLifetimeMs: 9000,
          maxLifetimeMs: 30000,
        }),
      )
      sky.start()
    }
  </script>
</Note>
