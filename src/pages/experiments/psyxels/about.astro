---
import { getCollection } from "astro:content"
import Note, { type NoteTheme } from "@/experiments/gallery/Note.astro"
import { PRESETS } from "@/experiments/psyxels/settings"

// The note's furniture is the gallery's; only the paint is Psyxels'. See
// docs/adr/20260828-the-piece-is-independent-the-gallery-is-not.
const entry = (await getCollection("experiments")).find(({ data }) => data.slug === "psyxels")
if (!entry) throw new Error("Psyxels: missing about.md")

// Taken from the primary rather than written down. This read `hsl(286, …)`,
// which is `DEFAULT_SETTINGS.hue` — while the backdrop below correctly runs the
// primary, `alive`, at 260. So the furniture was 26° off the field it sits on,
// the same fault Dangler had at 198°, from the same cause: an accent copied
// from the defaults, which nothing presentational should read. Saturation and
// lightness stay Psyxels' own. See CONTEXT.md on *primary*.
const primary = PRESETS[0]!.settings

const theme: NoteTheme = {
  bg: "#05050a",
  sheet: "rgb(5 5 10 / 82%)",
  fg: "#d6d3de",
  bright: "#f4f1f8",
  muted: "#867f92",
  edge: "rgb(255 255 255 / 12%)",
  accent: `hsl(${primary.hue}, 62%, 74%)`,
}
---

<Note entry={entry} theme={theme} backdrop={0.4}>
  <script>
    import { createPsyxels } from "@/experiments/psyxels/psyxels"
    import { PRESETS } from "@/experiments/psyxels/settings"

    const canvas = document.getElementById("backdrop")
    if (canvas instanceof HTMLCanvasElement) {
      // The featured scene, which is what the piece itself opens on — not the
      // defaults, which are the piece's *zero* rather than anything anyone
      // chose. No portrait is handed over, so a page whose featured scene became
      // the photographic one would need to pass an image the way the piece's own
      // page does.
      const scene = createPsyxels(canvas, PRESETS[0]!.settings)
      scene.start()
    }
  </script>
</Note>
