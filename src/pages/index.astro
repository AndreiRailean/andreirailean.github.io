---
import { Image } from "astro:assets"

import Layout from "@/layouts/Layout.astro"
import SocialLinks from "@/components/SocialLinks.astro"
import avatar from "@/assets/avatar.jpg"
---

<Layout title="Andrei Railean" description="Experienced web developer ready to help you and your team">
  {
    /* A published scene, running as this page's background.

      This is a **pasted embed**, and the point is that it looks like one. The
      snippet pins a runner by content hash and carries its scene as the packed
      address string — 19 characters — and that is the whole of the coupling.
      Nothing here imports from `@/experiments`, nothing is generated into this
      file, and the section does not know this page exists. The experiments are a
      third-party system that happens to share a domain.

      Which is why the runner URL is root-relative rather than absolute: the
      origin is a fact about where a page lives, not about how tightly it is
      coupled. A stranger's snippet names `https://www.andrei.md/...` because
      their page is elsewhere; this page is on the same origin today, and will
      grow an origin the day the section gets its own.

      **The hash is pinned, so this scene does not follow the piece.** Changing
      Starry Night writes a new runner beside this one and leaves this page
      exactly as it is, until somebody deliberately republishes it.
      `tests/unit/showcase-runners.test.ts` fails if the runner named here is not
      committed, because the failure is otherwise silent — the loader falls back
      to the dot pattern below.

      Two scenes, because this page has a light and a dark mode. Pairing them is
      the host's job: a copy-embed button gives one scene, and an embed offers
      the switch as a convenience rather than deciding it. */
  }
  <div
    id="showcase-bg"
    data-showcase-runner="/showcase/runners/starry-night.490e5f9452c8.js"
    data-showcase-scene="__9ALCzBTyq1YkAPAyI"
    data-showcase-scene-dark="__9ADCzBTyq1YkAPAyI"
  >
  </div>

  <style is:global>
    #showcase-bg {
      position: fixed;
      inset: 0;
      z-index: 0;
    }

    /* A `position: fixed` box outranks unpositioned block content in the paint
       order whatever the DOM order says, so without this the canvas covers the
       page. The footer needs no such rule — it is already `fixed` with its own
       z-index for the theme toggle, and giving it `position: relative` here
       would undo that and hide the toggle. */
    main {
      position: relative;
      z-index: 1;
    }

    /* The scrim: the background dulled a few notches under the text, and only
       under the text. Drawn from the theme's own `--background`, so one rule
       serves both schemes and neither can drift from the page it sits on.

       Inside `main`'s stacking context at `z-index: -1`, which puts it behind
       the words and in front of the canvas — the canvas is outside that context
       entirely. A gradient rather than a shape, so it has no edge to notice. */
    main::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      background: radial-gradient(
        ellipse 46rem 30rem at 50% 46%,
        hsl(var(--background) / 78%) 0%,
        hsl(var(--background) / 55%) 42%,
        hsl(var(--background) / 0%) 72%
      );
    }
  </style>

  {
    /* A module, deliberately, and that is the whole fix for a flash.

      `<Footer>` carries the script that puts `.dark` on the document, and the
      footer renders *after* this slot. A classic inline script here therefore
      reads the class before it exists, decides "light", and the background
      mounts wrong; whether it then corrects itself depends on a race with the
      theme toggle hydrating. A module runs after parsing, by which time the
      class is settled, and modules execute in document order so this one is
      guaranteed to be ahead of the loader below. */
  }
  <script>
    const scheme = () => (document.documentElement.classList.contains("dark") ? "dark" : "light")
    document.getElementById("showcase-bg")!.dataset.showcaseVariant = scheme()

    // For every later change. `window.showcase` may not exist yet — the loader
    // is the next module — so it is checked when the toggle fires, not now.
    new MutationObserver(() => window.showcase?.setVariant(scheme())).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    })
  </script>

  <script is:inline type="module" src="/showcase/embed.js"></script>

  <main class="m-0 flex grow flex-col items-center justify-center px-6 py-8 md:px-10 md:py-10">
    <div class="flex flex-col space-y-3 md:w-[40rem] md:space-y-5">
      <div class="flex justify-center">
        {/* Eager: it is the first thing on the page, and Astro's Image lazy-loads by default. */}
        <Image
          src={avatar}
          alt="Andrei Railean"
          width={128}
          height={128}
          densities={[1, 2]}
          loading="eager"
          class="size-32 shrink-0 rounded-full border-6 border-gray-300 object-cover dark:border-gray-300"
        />
      </div>
      <h1 class="text-center">Andrei Railean</h1>

      <h2 class="pt-3 text-center">Software engineer</h2>

      <p class="text-center md:text-lg">
        Building high-quality, scalable web applications with a strong focus on performance and maintainability for over
        20 years.
      </p>
    </div>

    <div class="mt-4 text-center md:mt-10">
      <SocialLinks />
    </div>
  </main>
</Layout>
